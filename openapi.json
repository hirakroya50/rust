      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Replace user",
        "description": "Send all required fields. Omitted optional fields become null; omitted stock becomes zero.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
