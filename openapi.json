  },
  "components": {
    "schemas": {
      "UserInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Hirak Roy"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "hirak@example.com"
          },
          "phone": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Keyboard"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]{1,10}(\\.[0-9]{1,2})?$",
            "example": "199.99"
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "default": 0
          },
          "category": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Hirak Roy"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "hirak@example.com"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "name",
          "description",
          "price",
          "stock",
          "category",
          "id",
          "created_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Keyboard"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]{1,10}(\\.[0-9]{1,2})?$",
            "example": "199.99"
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "default": 0
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
